# Copy to the repository-root .env and fill locally. Never commit real secrets.
# Use the account identifier, not a full snowflakecomputing.com URL.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Interactive MFA alternative: leave PASSWORD empty and uncomment:
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Existing objects in your own account; no resources or roles are created.
SNOWFLAKE_DATABASE=NYC_TRANSIT_PLANNER
SNOWFLAKE_SCHEMA=ANALYTICS
# Fill with an existing permitted role/warehouse, or leave empty for user defaults.
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_CORTEX_MODEL=llama3.3-70b
# Required if SCORING_RUNS contains multiple runs. Leave empty for a single run.
SNOWFLAKE_SCORING_RUN_ID=
