# Copy this file to .env and fill it in. .env is ignored by git; never commit it.
# Account identifier looks like ORGNAME-ACCOUNTNAME (Snowsight > your name > Connect a tool).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Your password or a programmatic access token. Leave empty if using the browser login below.
SNOWFLAKE_PASSWORD=
# Uncomment to log in through the browser instead (works with MFA).
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# These match snowflake/setup.sql; change only if you set things up differently.
SNOWFLAKE_ROLE=TRANSIT_TEAM
SNOWFLAKE_WAREHOUSE=TRANSIT_WH
SNOWFLAKE_DATABASE=TRANSIT_GAP
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_CORTEX_MODEL=mistral-large2
